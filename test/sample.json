{
  "schema": "account-domino-mapper/sample@1",
  "about": {
    "ja": "Day127 Account Domino Mapper の学習用サンプル。架空の3人で、実在の人物・サービス・会社とは関係ない。パスワードの文字列は持たず、系統（色と記号）だけを持つ。単純化した模型である。",
    "en": "Sample data for learning with Day127 Account Domino Mapper. Three fictional people; no relation to real people, services or companies. No password strings, only password families (colour and letter). A simplified model."
  },
  "lineKinds": {
    "pw": { "ja": "パスワードの系統", "en": "Password family" },
    "mfa": { "ja": "多要素（スマホの認証アプリ・パスキー）", "en": "Second factor (authenticator app / passkey on the phone)" },
    "mail": { "ja": "メール（回復メール・メールに届くコード）", "en": "Email (recovery email / emailed code)" },
    "sms": { "ja": "SMS（電話番号）", "en": "SMS (phone number)" },
    "desk": { "ja": "窓口（本人確認）", "en": "Help desk (identity check)" },
    "paper": { "ja": "紙の回復コード", "en": "Paper recovery code" }
  },
  "credentialTypes": {
    "pw": "pw",
    "device": "mfa",
    "phone": "sms",
    "info": "desk",
    "idcheck": "desk",
    "paper": "paper"
  },
  "notes": {
    "sms": {
      "ja": "SMSの線は、SIMスワップのカードがあるときだけ攻撃者に開く可能性がある（模型の単純化。調査は米国のプリペイド5社のもので、日本の携帯会社に当てはめない）",
      "en": "An SMS line may open for the attacker only when the SIM-swap card is in play (a simplification; the study covered five US prepaid carriers and is not applied to Japanese carriers)."
    },
    "passkey": {
      "ja": "パスキーは「スマホの中の鍵」として扱う。同期パスキーがクラウドのアカウントの回復で取り出せる経路は、この模型に入れていない",
      "en": "A passkey is treated as a key inside the phone. Retrieving synced passkeys through cloud-account recovery is outside this model."
    },
    "desk": {
      "ja": "窓口は2段階に分ける。電話の窓口は個人情報で通り、書類での本人確認（身分証の提示・登録住所への郵送）を破るカードは模型にない",
      "en": "Help desks come in two levels. A phone desk accepts personal details; no card in the model defeats a document check (photo ID in person, postal mail to the registered address)."
    },
    "paper": {
      "ja": "紙の回復コードは本人の手元にだけある。攻撃カードでは手に入らない",
      "en": "Paper recovery codes exist only in the owner's hands; no attack card yields them."
    },
    "leak": {
      "ja": "漏えいのカード（leaks）が渡すのは、漏れたサービスがいまログインに使っているパスワードの系統である。1手でそのサービスの系統を付け替えると、渡すものも変わる（系統を gives に書いて固定すると、漏れたサービス自身の系統を変える手を正しく評価できない）",
      "en": "A breach card (leaks) yields the password family that the breached service currently uses for log-in. If a move changes that service's family, the card yields the new one (hard-coding the family mis-scores moves on the breached service itself)."
    }
  },
